# Production environment — copy to .env and fill in values
# Required by docker-compose.yml

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=crm_hoangkhang

# Backend
JWT_SECRET=CHANGE_ME_random_secret_at_least_32_chars
BACKEND_PORT=3001

# Set to "true" ONLY for first deploy to create roles + admin account
# Then set back to false and redeploy/restart
SEED_DB=false

# Frontend — the PUBLIC URL of the backend API (as browsers will reach it)
# Example: https://api.crm.yourdomain.com or http://YOUR_VPS_IP:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000
